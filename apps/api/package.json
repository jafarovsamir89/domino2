    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/websockets": "^11.1.26",
    "@prisma/client": "^6.7.0",
    "@sentry/nestjs": "^10.62.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-auth": "^1.7.10",
    "class-transformer": "^0.5.1",
